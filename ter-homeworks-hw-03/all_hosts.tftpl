[webservers]
%{ for vm in webservers ~}
${vm.name} ansible_host=${vm.network_interface[0].ip_address} fqdn=${vm.hostname}.ru-central1.internal
%{ endfor ~}

[databases]
%{ for vm in databases ~}
${vm.name} ansible_host=${vm.network_interface[0].ip_address} fqdn=${vm.hostname}.ru-central1.internal
%{ endfor ~}

[storage]
%{ for vm in storage ~}
${vm.name} ansible_host=${vm.network_interface[0].ip_address} fqdn=${vm.hostname}.ru-central1.internal
%{ endfor ~}